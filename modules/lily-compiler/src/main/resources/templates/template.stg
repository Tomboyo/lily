record(type, fields, body) ::= <<
<if(type.package)>
package <type.package>;
<endif>
public record <type.name>(<fieldDecls(fields)>) {<\\>
<if(body)>
  <body; separator="\n\n">
<endif>
}
>>

emptyFactory(type, parameters) ::= <<
public static <qualify(type)> empty() {
  return new <qualify(type)>(<parameters; separator=", ">);
}
>>

wither(returns, name, param, ctorParams) ::= <<
public <qualify(returns)> with<name; format="cap">(<fieldDecl(param)>) {
  return new <qualify(returns)>(<ctorParams; separator=", ">);
}
>>

fieldDecls(fields) ::= "<fields:fieldDecl(); separator=\", \">"

fieldDecl(field) ::= "<qualify(field.type)> <field.name>"

qualify(type) ::= <<
<if(type.package)><type.package>.<endif><\\>
<type.name><\\>
<if(type.parameters)>\<<type.parameters:qualify(); separator=", ">\><endif>
>>

